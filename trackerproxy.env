################################################################
#### Base Environment Variables
################################################################
## Compose Project Definition
PROJECT = trackerproxy ## Compose project name

## Project Persistence Directories
APPDATA_DIR = ${DOCKER_BASE_APPDATA_DIR}/${PROJECT}
SECRETS_DIR = ${SECRETS_BASE_DIR}/${PROJECT}.secrets
CACHE_DIR = ${CONTAINER_CACHE_DIR}/${PROJECT}
LOGS_DIR = ${CONTAINER_LOGS_DIR}/${PROJECT}
SHARE_DIR = ${CONTAINER_SHARE_DIR}/${PROJECT}
SCRIPTS_DIR = ${SCRIPTS_BASE_DIR}/${PROJECT}
DATA_DIR = ${DATA_BASE_DIR}
SSD_DIR = ${SSD_TEMP_DIR}.${PROJECT}
DOCKER_HOST = ${DEFAULT_DOCKER_HOST}
RESTART_POLICY = ${RESTART_POLICY_APP}

## Container User
PUID = ${DEFAULT_PUID}
PGID = ${DEFAULT_PGID}
UMASK = ${DEFAULT_UMASK}
TZ = ${DEFAULT_TZ}

################################################################
#### trackerproxy
################################################################
TRACKERPROXY_IMAGE = adhdtiger/trackerproxy ## Docker Image
TRACKERPROXY_IMAGE_TAG = tigger             ## Image Tag
TRACKERPROXY_CONFIG_DIR = /config           ## Container internal config directory
TRACKERPROXY_APP_PORT = 80                  ## Application default port

## Application FQDN
TRACKERPROXY_SUBDOMAIN_NAME = trackerproxy
TRACKERPROXY_DOMAIN_NAME = ${TRACKERPROXY_SUBDOMAIN_NAME}.${DOMAIN_NAME}
